# Copy this file to .env and adjust values. docker compose reads .env automatically.
# Never commit .env if it ever contains real secrets.

# Logging
LOG_LEVEL=INFO

# TraceFlow - tail-based sampling
LATENCY_THRESHOLD_MS=2000
TRACE_IDLE_TIMEOUT_SECONDS=10
BASELINE_SAMPLE_RATE=0.0

# Demo application
PAYMENT_SLOW_DELAY_SECONDS=5